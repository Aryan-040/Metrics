    { "from": 410, "to": 510, "label": "Cache Fill & Response" }
  ],
  "messages": [
    { "id": "http-req",    "from": "browser", "to": "api",     "y": 165, "label": "GET /data",          "variant": "emphasis" },
    { "id": "cache-get",   "from": "api",     "to": "redis",   "y": 210, "label": "GET cache-key",      "variant": "default" },
    { "id": "cache-miss",  "from": "redis",   "to": "api",     "y": 245, "label": "nil (cache miss)",   "variant": "return" },
    { "id": "db-query",    "from": "api",     "to": "pg",      "y": 295, "label": "SELECT query",       "variant": "emphasis" },
    { "id": "db-rows",     "from": "pg",      "to": "api",     "y": 340, "label": "result rows",        "variant": "return" },
    { "id": "cache-set",   "from": "api",     "to": "redis",   "y": 390, "label": "SET cache-key (TTL)","variant": "dashed" },
    { "id": "cache-ack",   "from": "redis",   "to": "api",     "y": 420, "label": "OK",                 "variant": "return" },
    { "id": "http-resp",   "from": "api",     "to": "browser", "y": 465, "label": "200 JSON",           "variant": "return" }
  ],
  "activations": [
    { "participant": "api",   "from": 160, "to": 472, "type": "backend" },
    { "participant": "redis", "from": 205, "to": 252, "type": "database" },
    { "participant": "pg",    "from": 290, "to": 347, "type": "database" },
    { "participant": "redis", "from": 385, "to": 427, "type": "database" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Cache Hit Path (future requests)",
      "items": [
        "On a cache hit Redis returns data directly — no PostgreSQL query needed",
        "API responds immediately after the GET cache-key call",
        "Latency drops from DB round-trip to sub-millisecond Redis read"
      ]
    },
    {
      "dot": "rose",
      "title": "Cache Miss Flow",
      "items": [
        "Redis returns nil, signalling the key is absent or expired",
        "API falls back to PostgreSQL with a SELECT query",
        "Result rows are returned and used to build the HTTP response"
      ]
    },
    {
      "dot": "cyan",
      "title": "Cache Fill",
      "items": [
        "After the DB read, API writes the result back to Redis with a TTL",
        "Subsequent requests for the same key will hit the cache",
        "SET is fire-and-continue — response is sent after the ACK"
      ]
    }
  ]
}
