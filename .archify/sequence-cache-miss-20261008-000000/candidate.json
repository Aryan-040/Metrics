  "participants": [
    { "id": "browser", "type": "external",  "label": "Browser",    "sublabel": "client" },
    { "id": "api",     "type": "backend",   "label": "API",        "sublabel": "request handler" },
    { "id": "redis",   "type": "database",  "label": "Redis",      "sublabel": "cache layer" },
    { "id": "pg",      "type": "database",  "label": "PostgreSQL", "sublabel": "source of truth" }
  ],
  "segments": [
    { "from": 150, "to": 260, "label": "Inbound Request" },
